_inputs: final: prev:
let
  # libadwaita support for the WhiteSur GTK theme — a *view* of the theme
  # package, not a package of its own.
  #
  # `whitesur-gtk-theme` ships its GTK 4 stylesheet compiled into a gresource
  # (`gtk-4.0/gtk.gresource`) and soft-links the loose `gtk.css` shim at it.
  # Native GTK 4 applications are fine with that, because
  # `gtk_css_provider_load_named` loads the gresource sitting next to the
  # resolved `gtk-<variant>.css`. libadwaita applications are not: they ignore
  # `gtk-theme-name` entirely and only read `$XDG_CONFIG_HOME/gtk-4.0/gtk.css`
  # (GTK's "user" style provider).
  #
  # Upstream's `install.sh --libadwaita` works around this by sassc-compiling
  # the two variants and copying the asset trees into `~/.config/gtk-4.0`, then
  # linking `gtk.css` at whichever variant was selected at install time — the
  # choice is frozen and the directory is mutable state. This produces the same
  # files in the store instead, plus a `gtk.css` that picks the variant at
  # runtime through `@media (prefers-color-scheme: ...)`. GTK 4 re-parses the
  # user stylesheet whenever the colour scheme changes
  # (gtk/gtkcssprovider.c:942 rerenders on PROP_PREFERS_COLOR_SCHEME) and skips
  # non-matching `@media` bodies wholesale, including an `@import` inside them —
  # verified against gtk 4.24 with a C probe.
  #
  # Two consequences worth knowing before editing:
  #   * the imports in `gtk.css` must be ABSOLUTE `file:` URLs. GTK resolves a
  #     relative `url()` against the directory of the CSS file it is currently
  #     parsing, and once Home Manager symlinks `~/.config/gtk-4.0/gtk.css` into
  #     the store that directory is `~/.config/gtk-4.0`, where the variants do
  #     not exist.
  #   * the assets have to sit next to each variant stylesheet, because the
  #     compiled WhiteSur CSS references `assets/...` and `windows-assets/...`
  #     relatively. Only `gtk.css` differs between the two gresources; all 199
  #     asset entries are byte-identical, so they are extracted once from the
  #     light variant.
  #
  # This lives in an overlay rather than `pkgs/by-name` on purpose: the update
  # bot walks every in-repo package and asks nix-update for its upstream URL.
  # A derived view has no upstream of its own — its `src` is the theme
  # derivation, not a fetcher — so nix-update aborts the whole run with
  # "Could not find a url in the derivations src attribute". Keeping it out of
  # the by-name tree keeps it out of that list, and the theme package's own
  # updateScript still bumps it, because the version is inherited.
  whitesur-libadwaita = final.stdenv.mkDerivation (finalAttrs: {
    pname = "whitesur-libadwaita";
    inherit (prev.whitesur-gtk-theme) version;

    # The gresource is the only input and it is not fetchable on its own.
    src = prev.whitesur-gtk-theme;

    nativeBuildInputs = [ final.glib.dev ];

    dontConfigure = true;
    dontBuild = true;

    installPhase = ''
      runHook preInstall

      gres_light="${prev.whitesur-gtk-theme}/share/themes/WhiteSur-Light/gtk-4.0/gtk.gresource"
      gres_dark="${prev.whitesur-gtk-theme}/share/themes/WhiteSur-Dark/gtk-4.0/gtk.gresource"
      target="$out/share/whitesur-libadwaita"

      install -dm0755 "$target"

      gresource extract "$gres_light" /org/gnome/theme/gtk.css > "$target/gtk-Light.css"
      gresource extract "$gres_dark" /org/gnome/theme/gtk.css > "$target/gtk-Dark.css"

      # Assets are identical in both variants, so extracting the light
      # gresource is enough for either branch of the media query below.
      gresource list "$gres_light" | while read -r path; do
        case "$path" in
          /org/gnome/theme/gtk.css | /org/gnome/theme/gtk-dark.css) continue ;;
        esac
        rel="''${path#/org/gnome/theme/}"
        mkdir -p "$target/$(dirname "$rel")"
        gresource extract "$gres_light" "$path" > "$target/$rel"
      done

      cat > "$target/gtk.css" <<EOF
      /* Generated by ${finalAttrs.pname}. Selects the WhiteSur variant through the
         GTK colour scheme so that a light/dark switch needs no file rewriting. */
      @media (prefers-color-scheme: light) {
        @import url("file://$target/gtk-Light.css");
      }
      @media (prefers-color-scheme: dark) {
        @import url("file://$target/gtk-Dark.css");
      }
      EOF

      runHook postInstall
    '';

    meta = {
      description = "WhiteSur GTK theme prepared for libadwaita, switchable via prefers-color-scheme";
      homepage = "https://github.com/vinceliuice/WhiteSur-gtk-theme";
      license = final.lib.licenses.mit;
      platforms = final.lib.platforms.all;
    };
  });
in
{
  inherit whitesur-libadwaita;
}
